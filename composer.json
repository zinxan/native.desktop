{
    "name": "zinxan/native-desktop",
    "description": "Error tracking for NativePHP desktop apps, reported to NativeWatch.",
    "keywords": [
        "nativephp",
        "laravel",
        "desktop",
        "error-tracking",
        "nativewatch"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "zinxan/native-core": "^0.2"
    },
    "suggest": {
        "nativephp/desktop": "The NativePHP desktop runtime that this SDK reports for."
    },
    "autoload": {
        "psr-4": {
            "ZXN\\NativeWatch\\Desktop\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZXN\\NativeWatch\\Desktop\\DesktopServiceProvider"
            ],
            "aliases": {
                "NativeWatch": "ZXN\\NativeWatch\\Core\\Laravel\\NativeWatch"
            }
        }
    },
    "minimum-stability": "stable",
    "homepage": "https://native.watch",
    "support": {
        "docs": "https://native.watch/docs",
        "issues": "https://github.com/zinxan/native.desktop/issues",
        "source": "https://github.com/zinxan/native.desktop"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-type-coverage": "^3.0|^4.0|^5.0"
    },
    "autoload-dev": {
        "psr-4": {
            "ZXN\\NativeWatch\\Desktop\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ],
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --memory-limit=1G",
        "test:unit": "pest --compact",
        "test:type-coverage": "pest --type-coverage --min=100"
    }
}
