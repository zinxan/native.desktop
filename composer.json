{
    "name": "zinxan/native-desktop",
    "description": "Error tracking for NativePHP desktop apps, reported to NativeWatch.",
    "keywords": ["nativephp", "laravel", "desktop", "error-tracking", "nativewatch"],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "zinxan/native-core": "^0.1"
    },
    "suggest": {
        "nativephp/desktop": "The NativePHP desktop runtime that this SDK reports for."
    },
    "autoload": {
        "psr-4": {
            "ZXN\\NativeWatch\\Desktop\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZXN\\NativeWatch\\Desktop\\DesktopServiceProvider"
            ],
            "aliases": {
                "NativeWatch": "ZXN\\NativeWatch\\Core\\Laravel\\NativeWatch"
            }
        }
    },
    "minimum-stability": "stable"
}
